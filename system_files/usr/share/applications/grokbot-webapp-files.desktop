[Desktop Entry]
Type=Application
Name=파일
Name[en]=Files
Comment=홈 폴더의 파일 보기, 열기, 이름 바꾸기, 휴지통
Comment[en]=Browse, open, rename and trash files in your home folder
Exec=/usr/local/bin/grokbot-webapp files
Icon=/usr/share/grokbot/webapps/files/icon.svg
Terminal=false
Categories=System;FileManager;
StartupWMClass=grokbot-webapp-files
X-GrokBot-WebApp=files
