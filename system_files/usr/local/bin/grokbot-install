#!/bin/bash
# Install apps for the signed-in grokbot user.
# The Grok Bot app shells out to this command. It does not need root.
#
#   grokbot-install [--json] flatpak <app-id> [--name <name>]
#   grokbot-install [--json] local --id <id> --name <name> --source <path> [--exec <rel>]
#   grokbot-install [--json] list
#   grokbot-install [--json] remove <id>
#
# Spec: docs/GROKBOT_INSTALL.md
set -euo pipefail

# shellcheck source=/dev/null
source "${GROKBOT_LIB:-/usr/lib/grokbot/common.sh}"

JSON=0
if [[ "${1:-}" == "--json" ]]; then
    JSON=1
    shift
fi

fail() {
    local code="$1"
    local err="$2"
    local msg="$3"
    if [[ "$JSON" -eq 1 ]]; then
        printf '{"ok":false,"error":"%s","message":"%s"}\n' "$err" "$msg"
    else
        printf 'grokbot-install: %s\n' "$msg" >&2
    fi
    exit "$code"
}

usage() {
    fail 2 "usage" "usage: grokbot-install [--json] flatpak|local|list|remove ..."
}

if [[ "$(id -u)" -eq 0 && -z "${GROKBOT_INSTALL_ALLOW_ROOT:-}" ]]; then
    fail 1 "refusing_root" "refusing to run as root; apps install into the user home"
fi

if [[ -z "${HOME:-}" || "$HOME" == "/" ]]; then
    fail 1 "bad_home" "HOME is missing"
fi
case "$HOME" in
    *[[:space:]]* | *\"* | *\'*)
        fail 1 "bad_home" "HOME must not contain spaces or quotes"
        ;;
esac

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
    usage
fi
shift

manifest_dir="${HOME}/.local/share/grokbot/installed"
apps_dir="${HOME}/Apps"
desktop_dir="${HOME}/.local/share/applications"
mkdir -p "$manifest_dir" "$apps_dir" "$desktop_dir"

json_string_ok() {
    case "$1" in
        *\"* | *\\* | *$'\n'* | *$'\r'*) return 1 ;;
        *) return 0 ;;
    esac
}

write_manifest() {
    local id="$1" kind="$2" name="$3"
    if ! json_string_ok "$id" || ! json_string_ok "$kind" || ! json_string_ok "$name"; then
        fail 1 "bad_manifest" "refusing unsafe manifest fields"
    fi
    cat >"${manifest_dir}/${id}.json" <<EOF
{"id":"${id}","kind":"${kind}","name":"${name}"}
EOF
}

ok_line() {
    local id="$1" kind="$2" name="$3"
    if [[ "$JSON" -eq 1 ]]; then
        printf '{"ok":true,"id":"%s","kind":"%s","name":"%s"}\n' "$id" "$kind" "$name"
    else
        printf '설치됨: %s (%s)\n' "$name" "$id"
    fi
}

valid_local_id() {
    [[ "$1" =~ ^[a-z][a-z0-9._-]{0,62}$ ]]
}

valid_flatpak_id() {
    [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]]
}

valid_name() {
    # One desktop-file line and one JSON string. Reject quotes, escapes,
    # control characters, and the few ASCII marks that would break either.
    local name="$1"
    [[ -n "$name" && ${#name} -le 80 ]] || return 1
    case "$name" in
        *\"* | *\\* | *[[:cntrl:]]* | *'='* | *'#'* | *'['* | *']'*) return 1 ;;
        *) return 0 ;;
    esac
}

manifest_field() {
    local file="$1" key="$2"
    sed -n "s/.*\"${key}\":\"\\([^\"]*\\)\".*/\\1/p" "$file" | head -n 1
}

cmd_flatpak() {
    local app_id="${1:-}"
    local name=""
    if [[ -z "$app_id" ]]; then
        usage
    fi
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                name="${2:-}"
                shift 2
                ;;
            *) usage ;;
        esac
    done
    valid_flatpak_id "$app_id" || fail 2 "invalid_app_id" "flatpak app id must look like org.example.App"
    if [[ -z "$name" ]]; then
        name="$app_id"
    fi
    valid_name "$name" || fail 2 "invalid_name" "name contains a forbidden character"
    if [[ -e "${manifest_dir}/${app_id}.json" ]]; then
        fail 2 "already_installed" "already installed; remove it first"
    fi
    if ! command -v flatpak >/dev/null 2>&1; then
        fail 1 "flatpak_missing" "flatpak is not installed"
    fi
    if ! flatpak remote-add --user --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo; then
        fail 1 "flatpak_failed" "flatpak remote-add failed"
    fi
    # Show what the app asks for and let the user decide, every time
    # (security review #9). -y below only answers flatpak's own questions.
    local metadata
    if ! metadata=$(flatpak remote-info --user --show-metadata flathub "$app_id"); then
        fail 1 "flatpak_failed" "flatpak remote-info failed (unknown app?)"
    fi
    if ! printf '%s\n' "$metadata" | python3 "${GROKBOT_PYLIB:-/usr/lib/grokbot}/flatpak_consent.py" \
        "$app_id" "$name" "$PPID" 2>/dev/null; then
        fail 3 "denied" "the user did not allow installing ${app_id}"
    fi
    if ! flatpak install --user -y flathub "$app_id"; then
        fail 1 "flatpak_failed" "flatpak install failed"
    fi
    write_manifest "$app_id" "flatpak" "$name"
    ok_line "$app_id" "flatpak" "$name"
}

cmd_local() {
    local id="" name="" source="" exec_rel=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id)
                id="${2:-}"
                shift 2
                ;;
            --name)
                name="${2:-}"
                shift 2
                ;;
            --source)
                source="${2:-}"
                shift 2
                ;;
            --exec)
                exec_rel="${2:-}"
                shift 2
                ;;
            *) usage ;;
        esac
    done
    [[ -n "$id" && -n "$name" && -n "$source" ]] || usage
    valid_local_id "$id" || fail 2 "invalid_id" "local id must match [a-z][a-z0-9._-]{0,62}"
    valid_name "$name" || fail 2 "invalid_name" "name contains a forbidden character"
    if [[ -e "${manifest_dir}/${id}.json" || -e "${apps_dir}/${id}" ]]; then
        fail 2 "already_installed" "already installed; remove it first"
    fi
    if [[ -L "$source" ]]; then
        fail 2 "symlink" "refusing a symlink source"
    fi
    if [[ ! -e "$source" ]]; then
        fail 2 "missing_source" "source does not exist"
    fi

    local dest="${apps_dir}/${id}"
    grokbot_under_dir "$dest" "$apps_dir" || fail 1 "bad_dest" "destination escaped the Apps directory"
    mkdir -p "$dest"

    local exec_path=""
    if [[ -d "$source" ]]; then
        if [[ -z "$exec_rel" ]]; then
            rm -rf -- "$dest"
            fail 2 "exec_required" "directory installs require --exec RELATIVE_PATH"
        fi
        case "$exec_rel" in
            /* | *..* | *$'\n'* | *[[:space:]]*)
                rm -rf -- "$dest"
                fail 2 "bad_exec" "--exec must be a relative path inside the app directory"
                ;;
        esac
        [[ "$exec_rel" =~ ^[A-Za-z0-9._+/-]+$ ]] || {
            rm -rf -- "$dest"
            fail 2 "bad_exec" "--exec contains a forbidden character"
        }
        if find "$source" -type l -print -quit | grep -q .; then
            rm -rf -- "$dest"
            fail 2 "symlink" "refusing a source tree that contains a symlink"
        fi
        cp -a "${source}/." "$dest/"
        exec_path="${dest}/${exec_rel}"
        grokbot_under_dir "$exec_path" "$dest" || {
            rm -rf -- "$dest"
            fail 2 "bad_exec" "--exec escaped the app directory"
        }
        if [[ ! -f "$exec_path" || -L "$exec_path" ]]; then
            rm -rf -- "$dest"
            fail 2 "bad_exec" "--exec is not a regular file inside the app directory"
        fi
        chmod +x "$exec_path"
    elif [[ -f "$source" ]]; then
        if [[ -n "$exec_rel" ]]; then
            rm -rf -- "$dest"
            fail 2 "bad_exec" "--exec is only used when --source is a directory"
        fi
        exec_path="${dest}/${id}"
        cp -a -- "$source" "$exec_path"
        chmod +x "$exec_path"
    else
        rm -rf -- "$dest"
        fail 2 "bad_source" "source must be a regular file or a directory"
    fi

    local desktop="${desktop_dir}/grokbot-local-${id}.desktop"
    cat >"$desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=${name}
Exec=${exec_path}
Terminal=false
Categories=Utility;
StartupWMClass=${id}
EOF
    write_manifest "$id" "local" "$name"
    ok_line "$id" "local" "$name"
}

cmd_list() {
    [[ $# -eq 0 ]] || usage
    local first=1 file
    if [[ "$JSON" -eq 1 ]]; then
        printf '['
    fi
    shopt -s nullglob
    for file in "${manifest_dir}"/*.json; do
        if [[ "$JSON" -eq 1 ]]; then
            if [[ "$first" -eq 0 ]]; then
                printf ','
            fi
            first=0
            tr -d '\n' <"$file"
        else
            cat "$file"
            printf '\n'
        fi
    done
    shopt -u nullglob
    if [[ "$JSON" -eq 1 ]]; then
        printf ']\n'
    fi
}

cmd_remove() {
    local id="${1:-}"
    [[ -n "$id" ]] || usage
    [[ $# -eq 1 ]] || usage
    local manifest="${manifest_dir}/${id}.json"
    if [[ ! -f "$manifest" ]]; then
        fail 2 "not_installed" "not installed"
    fi
    if [[ -L "$manifest" ]]; then
        fail 1 "symlink" "refusing a symlinked manifest"
    fi
    local kind name
    kind=$(manifest_field "$manifest" "kind")
    name=$(manifest_field "$manifest" "name")
    case "$kind" in
        flatpak)
            valid_flatpak_id "$id" || fail 1 "invalid_app_id" "manifest app id is not a flatpak id"
            if ! flatpak uninstall --user -y "$id"; then
                fail 1 "flatpak_failed" "flatpak uninstall failed"
            fi
            ;;
        local)
            valid_local_id "$id" || fail 1 "invalid_id" "manifest id is not a local id"
            local dest="${apps_dir}/${id}"
            local desktop="${desktop_dir}/grokbot-local-${id}.desktop"
            if [[ -L "$dest" || -L "$desktop" ]]; then
                fail 1 "symlink" "refusing to delete a symlink"
            fi
            grokbot_under_dir "$dest" "$apps_dir" || fail 1 "bad_dest" "destination escaped the Apps directory"
            rm -rf -- "$dest"
            rm -f -- "$desktop"
            ;;
        *)
            fail 1 "bad_manifest" "unknown install kind"
            ;;
    esac
    rm -f -- "$manifest"
    if [[ "$JSON" -eq 1 ]]; then
        printf '{"ok":true,"id":"%s","kind":"%s","removed":true}\n' "$id" "$kind"
    else
        printf '제거됨: %s (%s)\n' "${name:-$id}" "$id"
    fi
}

case "$cmd" in
    flatpak) cmd_flatpak "$@" ;;
    local) cmd_local "$@" ;;
    list) cmd_list "$@" ;;
    remove) cmd_remove "$@" ;;
    *) usage ;;
esac
