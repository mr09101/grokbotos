// The logged-in, local, active session user may start exactly these
// units (no stop/restart, no other units). grokbotd asks the user before
// starting check, apply or rollback (docs/OS_UPDATES.md).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.local && subject.active &&
        action.lookup("verb") == "start") {
        var u = action.lookup("unit");
        if (u == "grokbot-update@status.service" || u == "grokbot-update@check.service" ||
            u == "grokbot-update@apply.service" || u == "grokbot-update@rollback.service") {
            return polkit.Result.YES;
        }
    }
});
